y = "PC2"
)
# Porcentaje de varianza explicada
var_exp <- (pca$sdev^2 / sum(pca$sdev^2)) * 100
var_exp
pc1_label <- paste0("PC1 (", round(var_exp[1], 2), "%)")
pc2_label <- paste0("PC2 (", round(var_exp[2], 2), "%)")
## PCA por provincia
