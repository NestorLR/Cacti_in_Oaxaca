comparar_especie <- function(datos, variable) {
datos %>%
group_by(Species) %>%
group_modify(~ {
d <- .x
if (n_distinct(d$Province) != 2 ||
any(table(d$Province) < 2)) {
return(tibble(
diferencia = NA_real_,
p = NA_real_
))
}
prueba <- t.test(
d[[variable]] ~ d$Province
)
tibble(
diferencia = unname(
diff(rev(prueba$estimate))
),
p = prueba$p.value
)
}) %>%
ungroup() %>%
mutate(
p_ajustado = p.adjust(p, method = "BH"),
significativo = p_ajustado < 0.05
)
}
