sierra <- pca_results %>%
filter(Province == "Sierra Madre del Sur province") %>%
select(PC1, PC2)
veracruz <- pca_results %>%
filter(Province == "Veracruzan province") %>%
select(PC1, PC2)
ellipse_polygon <- function(df, level = 0.95, n = 200) {
xy <- as.matrix(df[, c("PC1", "PC2")])
centro <- colMeans(xy)
cov_mat <- cov(xy)
eig <- eigen(cov_mat)
theta <- seq(0, 2*pi, length.out = n)
circle <- rbind(cos(theta), sin(theta))
radius <- sqrt(qchisq(level, df = 2))
ellipse <- t(
centro +
radius * eig$vectors %*%
diag(sqrt(eig$values)) %*%
circle
)
st_polygon(list(ellipse))
}
ellipse_sierra <- ellipse_polygon(sierra)
library(dplyr)
library(sf)
ellipse_sierra <- ellipse_polygon(sierra)
